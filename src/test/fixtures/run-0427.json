        "type": "ctx",
        "text": "class RateLimiter:"
      },
      {
        "n1": 12,
        "n2": 13,
        "type": "ctx",
        "text": "    def __init__(self, redis: Redis, limit: int = 60):"
      },
      {
        "n1": 13,
        "n2": 14,
        "type": "ctx",
        "text": "        self.redis = redis"
      },
      {
        "n1": 14,
        "n2": 15,
        "type": "ctx",
        "text": "        self.limit = limit"
      },
      {
        "n1": 15,
        "n2": null,
        "type": "rem",
        "text": "    def is_allowed(self, key: str) -> bool:"
      },
      {
        "n1": 16,
        "n2": null,
        "type": "rem",
        "text": "        count = self.redis.incr(key)"
      },
      {
        "n1": 17,
        "n2": null,
        "type": "rem",
        "text": "        return count <= self.limit"
      },
      {
        "n1": null,
        "n2": 16,
        "type": "add",
        "text": "    def is_allowed(self, key: str) -> tuple[bool, int]:"
      },
      {
        "n1": null,
        "n2": 17,
        "type": "add",
        "text": "        current = self.redis.incr(key)"
      },
      {
        "n1": null,
        "n2": 18,
        "type": "add",
        "text": "        if current == 1:"
      },
      {
        "n1": null,
        "n2": 19,
        "type": "add",
        "text": "            self.redis.expire(key, 60)"
      },
      {
        "n1": null,
        "n2": 20,
        "type": "add",
        "text": "        remaining = max(0, self.limit - current)"
      },
      {
        "n1": null,
        "n2": 21,
        "type": "add",
        "text": "        return current <= self.limit, remaining"
      },
      {
        "n1": 24,
        "n2": 28,
        "type": "ctx",
        "text": "    def throttle_key(self, merchant_id: str) -> str:"
      },
      {
        "n1": 25,
        "n2": 29,
        "type": "ctx",
        "text": "        return f\"throttle:{merchant_id}\""
      }
    ]
