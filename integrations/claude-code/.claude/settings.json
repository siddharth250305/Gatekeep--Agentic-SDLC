{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__gatekeep"
    ],
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "LS",
      "BashOutput",
      "KillShell",
      "Skill",
      "SlashCommand"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "gatekeep"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/gatekeep-guard.mjs\""
          }
        ]
      }
    ]
  }
}
