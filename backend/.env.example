# Copy to .env and adjust. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://gatekeep:gatekeep@localhost:5432/gatekeep
PORT=4040
# Dashboard origin(s) allowed to call the API from a browser (comma-separated).
GATEKEEP_UI_ORIGINS=http://localhost:5180
# 1 = mount demo-only routes (the audit "Simulate Tamper Test"). Never set in production.
GATEKEEP_DEMO_MODE=0
# Shared secret the backend sends to the agent pipeline (same value in agents/).
GATEKEEP_PIPELINE_SECRET=
# Hours a dashboard login stays valid.
GATEKEEP_SESSION_HOURS=12
